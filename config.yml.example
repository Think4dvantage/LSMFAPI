meteoswiss:
  stac_base_url: "https://data.geo.admin.ch/api/stac/v1"
  ch1eps_collection: "ch.meteoschweiz.ogd-forecasting-icon-ch1"
  ch2eps_collection: "ch.meteoschweiz.ogd-forecasting-icon-ch2"

lenticularis:
  base_url: "https://lenticularis.lg4.ch"

# Where downloaded GRIB2 files persist across restarts. A CH2 run peaks at ~480 GB here
# (see .ai/context/architecture.md) — bind-mount this path onto a volume with headroom,
# never the container's writable layer.
grib_cache_dir: "/tmp/lsmfapi_grib"
